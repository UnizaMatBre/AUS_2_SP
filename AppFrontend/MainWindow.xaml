<Window x:Class="AppFrontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppFrontend"
        xmlns:viewmodel="clr-namespace:AppFrontend.ViewModels"
        xmlns:views="clr-namespace:AppFrontend.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
        
        <Window.Resources>
                <DataTemplate DataType="{x:Type viewmodel:TreeSelectionViewModel}">
                        <views:TreeSelectionView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodel:WorkingViewModel}">
                        <views:WorkingView/>
                </DataTemplate>
        </Window.Resources>
        
        <ContentControl
                Content="{Binding CurrentViewModel}"
        />
</Window>
